{
  "name": "flowstate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "pacing": "vite-node tools/pacing.ts --",
    "bench": "vite-node tools/bench.ts --",
    "baseline": "vitest run tests/playthrough.test.ts -t BASELINE",
    "check:tools": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --strict --skipLibCheck --lib ES2022,DOM tools/node-shim.d.ts tools/pacing.ts tools/bench.ts tools/tiers.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
